@startuml
title Scenario: NORMAL_DRIVING
note right
  Delay: 172ms / 60ms
  Risk: 1.67
  Road: dry
  Attack: delay_injection
end note

start

:Capture Camera Data;
:Detect Pedestrian (Camera);

if (Camera detects pedestrian?) then (yes)
  :CamPed = true;
else (no)
  :CamPed = false;
endif

:Capture LiDAR Data;
:Detect Pedestrian (LiDAR);

if (LiDAR detects pedestrian?) then (yes)
  :LidarPed = true;
else (no)
  :LidarPed = false;
endif

:Listen CamPed;
:Listen LidarPed;

if (CamPed == true OR LidarPed == true) then (yes)
  :#FFCCCC**Brake**;
  note right
     VIOLATION
    Delay: 172ms
    Exceeds limit!
  end note
else (no)
  :Accelerate;
endif

stop

@enduml
