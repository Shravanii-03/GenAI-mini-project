  "unresolved": false,
  "component": "acc_system",
  "vss_signals": [
   "Vehicle.ADAS.CruiseControl.IsActive"
  ],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R074",
  "text": "The steering system shall support wheel angles up to 540 degrees.",
