  "unresolved": false,
  "component": "braking_system",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R076",
  "text": "The watchdog shall be implemented in a separate hardware unit.",
  "deadline_ms": null,
  "unresolved": false,
