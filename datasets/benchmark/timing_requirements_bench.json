  ]
 },
 {
  "id": "R066",
  "text": "The driver alert latency budget is 50 ms in total, including a 5 ms bus delay.",
  "deadline_ms": 50,
  "unresolved": false,
  "component": "alert_module",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "multi_clause"
  ]
 },
 {
  "id": "R067",
  "text": "ACC must react within 300 ms; the brake request part must be sent within 100 ms.",
  "deadline_ms": 300,
  "unresolved": false,
  "component": "acc_system",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "multi_clause"
  ]
 },
 {
  "id": "R068",
  "text": "Safety mechanism activation, including diagnosis (20 ms) and reaction (30 ms), must complete within 50 ms.",
  "deadline_ms": 50,
  "unresolved": false,
  "component": "safety_monitor",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "multi_clause"
  ]
 },
 {
  "id": "R069",
  "text": "Total time from crash detection to airbag deployment shall be 15 ms, of which 5 ms is sensor processing.",
  "deadline_ms": 15,
  "unresolved": false,
  "component": "other",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "multi_clause"
  ]
 },
 {
  "id": "R070",
  "text": "From brake pedal press to brake light illumination, a maximum of 100 ms is allowed, with the lamp driver contributing at most 20 ms.",
  "deadline_ms": 100,
  "unresolved": false,
  "component": "other",
  "vss_signals": [
   "Vehicle.Chassis.Brake.PedalPosition",
   "Vehicle.Body.Lights.Brake.IsActive"
  ],
  "can_ids": [],
  "tags": [
   "multi_clause"
  ]
 },
 {
  "id": "R071",
  "text": "The emergency braking function shall log every activation event.",
  "deadline_ms": null,
  "unresolved": false,
  "component": "braking_system",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R072",
  "text": "The lane departure warning shall be both audible and visual.",
  "deadline_ms": null,
  "unresolved": false,
  "component": "lane_departure_system",
  "vss_signals": [
   "Vehicle.ADAS.LaneDepartureDetection.IsWarning"
  ],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R073",
  "text": "The driver shall be able to disable adaptive cruise control.",
