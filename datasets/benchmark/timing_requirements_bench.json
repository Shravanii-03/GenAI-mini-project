  "vss_signals": [
   "Vehicle.Chassis.SteeringWheel.Angle"
  ],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R075",
  "text": "Brake pressure shall not exceed 200 bar.",
