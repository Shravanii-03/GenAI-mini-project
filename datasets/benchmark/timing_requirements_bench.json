  ],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R078",
  "text": "The airbag control unit shall be diagnosable via OBD.",
  "deadline_ms": null,
  "unresolved": false,
  "component": "other",
  "vss_signals": [],
  "can_ids": [],
  "tags": [
   "no_deadline"
  ]
 },
 {
  "id": "R079",
